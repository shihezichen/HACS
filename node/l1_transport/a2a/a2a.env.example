# A2A 服务运行配置模板
#
# 用法：复制为 a2a.env（同目录）后按本机实际填写。
# 口径：**代码里零硬编码路径** —— a2a_svc.py / restart_a2a.py 里不出现任何绝对路径，
#       主机、端口、各配置文件位置全部只在这一份配置里。
# 格式：KEY=VALUE，# 起头为注释，值两侧引号会被去掉。

# ---- 监听 ----
A2A_HOST=100.x.y.z
A2A_PORT=9920

# ---- 程序与配置（绝对路径）----
A2A_SVC_SCRIPT=<a2a_svc.py 路径>
A2A_AGENTS_JSON=<agents.json 路径>
A2A_PEERS_JSON=<peers.json 路径>

# ---- 上下文自愈所需：OpenClaw 会话档案（只读）----
A2A_SESSIONS_JSON=<sessions.json 路径>

# ---- 上下文自愈·Hermes 后端所需（只读；本机不承载 Hermes agent 时可留空）----
A2A_HERMES_STATE_DB=<Hermes state.db 路径>
A2A_HERMES_AGENT_DIR=<Hermes 安装目录（用于读模型窗口表）>

# ---- 可选 ----
# Windows 专用：分离启动用的 pythonw.exe（缺省回退当前解释器）
A2A_PYTHONW=<pythonw.exe 路径>
# 把服务 stdout/stderr 追加到此文件（缺省丢弃）
A2A_LOG_FILE=

# HACS 环境变量样板
# 用法：cp .env.example .env，把 <...> 换成真值；.env 永不入库。
# 任何一项都不得写死在代码里，代码里一律 os.environ["XXX"]。

# ---- 对话台后端 ----------------------------------------------------
CHAT_PG_DSN=postgresql://<user>:<pass>@<host>:<port>/<db>
BB_PG_DSN=postgresql://<user>:<pass>@<host>:<port>/<db>
CHAT_SVC_HOST=127.0.0.1
CHAT_SVC_PORT=9980
CHAT_SVC_PHASE=group

# ---- 通信层 NATS ---------------------------------------------------
NATS_HOST=<tailnet-ip>:4222
NATS_USER=hacs
NATS_PASS_FILE=/etc/nats/<user>.pass

# ---- 团队 / 成员 ---------------------------------------------------
TEAM_DEFAULT_HUMAN_ID=<human-id>
AGENTS_JSON=<deploy-dir>/agents.json

# ---- 外部服务（全部走 ${ENV}，不落盘明文）--------------------------
GITHUB_TOKEN=<github-pat>
FEISHU_APP_ID=<app-id>
FEISHU_APP_SECRET=<app-secret>
ALIYUN_ACCESS_KEY_ID=<ak>
ALIYUN_ACCESS_KEY_SECRET=<sk>
TOP001_ADMIN_TOKEN=<token>

# ---- 部署 ----------------------------------------------------------
DEPLOY_SSH_KEY=/path/to/id_ed25519     # 路径，不是内容
TLS_DIR=/etc/ssl/hacs
HTTP_PROXY=http://127.0.0.1:4780

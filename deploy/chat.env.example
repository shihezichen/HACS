# 对话台后端（backend/chat_svc.py）运行配置模板
#
# 用法：复制为 chat.env 后按本机实际填写（或直接把 KEY=VALUE 写进 systemd 的
#       EnvironmentFile）。口径与 comm/a2a/a2a.env.example 一致：
#       **chat_svc.py 里零硬编码** —— 不出现任何绝对路径、真实 IP、成员 id，
#       环境相关值全部只在这一份配置里。

# ---- 数据库 ---------------------------------------------------------
CHAT_PG_DSN=postgresql://<user>:***@<host>:<port>/<db>
BB_PG_DSN=postgresql://<user>:***@<host>:<port>/<db>
# DSN 也可以放在受保护文件里（KEY=VALUE，一行一项）；与上面二选一：
CHAT_DSN_FILE=<pg.env 路径>

# ---- 监听 -----------------------------------------------------------
# 生产用 tailscale0 的 100.x 地址（公网入口另起一个绑 127.0.0.1 的实例）
CHAT_HOST=<tailnet-ip 或 127.0.0.1>
CHAT_PORT=9980
CHAT_PHASE=group

# ---- 配置目录 / 成员名册 / 身份 --------------------------------------
# 所有配置文件的默认落点：pg.env、view-session.key、agents.json、ssh 密钥…
CHAT_ENV_DIR=<deploy-dir>
AGENTS_JSON=<agents.json 路径>
# 多份 agents.json，冒号或分号分隔（后面读到的同名成员不覆盖先读到的）
CHAT_AGENTS_JSON=<path1:path2>
# tailnet 内免登录时把对端认作的人
TEAM_DEFAULT_HUMAN_ID=<人的成员 id>

# ---- 静态托管 -------------------------------------------------------
# 前端静态根（同源托管）；缺省 = 本文件同级的 ui/
CHAT_UI_DIR=<ui/ 所在目录>
# 后台侧 Vue 产物目录（与前台 ui/ 完全分离）；缺省 = 本文件同级的 admin-ui/
CHAT_ADMIN_UI_DIR=<admin-ui/ 所在目录>

# ---- 会话密钥 -------------------------------------------------------
# 与看板（view_auth）同一把：跨服务、跨子域共用登录态
CHAT_SESSION_KEY_FILE=<view-session.key 路径>

# ---- 上下文富化（可选）----------------------------------------------
# 把「读本机 Hermes 上下文」的动作 SSH 到另一台便宜执行器上；缺省关。
CHAT_ENRICH_ENABLE=0
CHAT_ENRICH_SSH=<user@host>
CHAT_ENRICH_REMOTE_CMD=<远端命令>
CHAT_ENRICH_SSH_BIN=<ssh 可执行文件>
CHAT_ENRICH_TIMEOUT=<秒>
CHAT_ENRICH_MIN_INTERVAL=<秒>

# ---- 日志 -----------------------------------------------------------
CHAT_LOG_LEVEL=INFO

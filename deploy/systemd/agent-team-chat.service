[Unit]
Description=Agent Team Chat (人机对话台后端, tailnet 9980)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 与黑板/看板同一个 DSN 来源（BB_PG_DSN）；chat_svc 会读它
EnvironmentFile=<deploy-dir>/pg.env
Environment=CHAT_SESSION_KEY_FILE=<deploy-dir>/view-session.key
Environment=CHAT_AGENTS_JSON=<deploy-dir>/agents.json
ExecStart=/usr/bin/python3 <deploy-dir>/chat_svc.py --host <host> --port 9980 --log-level INFO
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
